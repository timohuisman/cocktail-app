# Credentials for the Postgres container defined in docker-compose.yml.
# docker-compose.yml builds DATABASE_URL from these for the app container,
# so you only need to set them once (used for both the db container itself
# and the app's connection string).
POSTGRES_USER="cocktailapp"
POSTGRES_PASSWORD=""
POSTGRES_DB="cocktailapp"

# The domain the app is served on via your reverse proxy, used by the
# Traefik labels in docker-compose.yml (must match PLEX_APP_URL below).
DOMAIN="cocktails.example.com"

# Secret used by nuxt-auth-utils to encrypt/sign the session cookie.
# Generate one with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=""

# Fixed identifier for this app when talking to the Plex API. Generate ONCE
# with `uuidgen` and never change it afterwards (existing logged-in sessions
# don't depend on it, but Plex treats a changed client id as a new "app").
PLEX_CLIENT_ID=""

# The machine identifier of your own Plex Media Server. Logins are only
# accepted for Plex accounts that have access to this server. Find it by
# opening https://plex.tv/api/v2/resources?X-Plex-Token=YOUR_PLEX_TOKEN in a
# browser while logged in to plex.tv, or via Plex Web -> Settings -> General
# on the server itself (look for "Machine Identifier" in the URL/settings).
PLEX_SERVER_MACHINE_IDENTIFIER=""

# Public base URL the app is reachable on (used to build the Plex login
# callback). Must be reachable over HTTPS from the browser, e.g. the domain
# configured in your reverse proxy.
PLEX_APP_URL="https://cocktails.example.com"

# Set to "true" to skip the Plex login requirement entirely. For local
# development only, so you don't need real Plex credentials to test the app —
# never set this in production.
NUXT_PUBLIC_AUTH_DISABLED=""
